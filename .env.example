# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Cloud PostgreSQL (Supabase / Render / Neon):
DATABASE_URL=postgresql://postgres:<password>@<project-ref>.supabase.co:5432/postgres
# Local SQLite fallback for instant zero-dependency testing:
# DATABASE_URL=sqlite:///./onyxcurates.db

# -----------------------------------------------------------------------------
# Supabase Cloud Storage (Bucket: pin-images)
# -----------------------------------------------------------------------------
# Supabase Project URL or Project Reference ID
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase API Key (Publishable / Anon or Service Role key)
SUPABASE_KEY=your_supabase_key_here

# -----------------------------------------------------------------------------
# Amazon Associates Configuration
# -----------------------------------------------------------------------------
AMAZON_PARTNER_TAG=onyxcurates-20
AMAZON_ACCESS_KEY=mock_access_key
AMAZON_SECRET_KEY=mock_secret_key
AMAZON_HOST=webservices.amazon.com
AMAZON_REGION=us-east-1

# -----------------------------------------------------------------------------
# Local Storage Fallback (Optional)
# -----------------------------------------------------------------------------
UPLOAD_DIR=static/uploads
